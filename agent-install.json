{
  "schema": 1,
  "product": "Vela Browser",
  "platforms": ["windows-x64"],
  "releaseManifest": "https://github.com/accomplish07zrh-eng/vela-browser/releases/download/v{version}/aliasmode-agent-bootstrap.json",
  "bootstrapScript": "scripts/install-agent.ps1",
  "installedHelper": "%LOCALAPPDATA%\\Vela Browser\\vela-browser-mcp.exe",
  "mcp": {
    "transport": "stdio",
    "command": "%LOCALAPPDATA%\\Vela Browser\\playwright\\node\\node.exe",
    "args": ["%LOCALAPPDATA%\\Vela Browser\\playwright\\agent\\mcp-host.mjs"]
  }
}
