{
  "schema": 1,
  "product": "Vela Browser",
  "platforms": ["windows-x64"],
  "wingetId": "Vela Browser.Vela Browser",
  "releaseManifest": "https://github.com/aliasmode/aliasmode/releases/download/v{version}/aliasmode-agent-bootstrap.json",
  "bootstrapScript": "scripts/install-agent.ps1",
  "installedHelper": "%LOCALAPPDATA%\\Vela Browser\\aliasmode-mcp.exe",
  "mcp": {
    "transport": "stdio",
    "command": "%LOCALAPPDATA%\\Vela Browser\\playwright\\node\\node.exe",
    "args": ["%LOCALAPPDATA%\\Vela Browser\\playwright\\agent\\mcp-host.mjs"]
  }
}
